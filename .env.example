# Copy to .env. .env is not committed.
# Hostinger: use the MySQL hostname from hPanel. localhost works only when MySQL runs on this computer.
ConnectorStore__Host=
ConnectorStore__Port=3306
ConnectorStore__Database=
ConnectorStore__User=
ConnectorStore__Password=
ConnectorStore__SslMode=Preferred
# Base64-encoded 32-byte key. Encrypts DocuWare and Sage passwords stored in MySQL.
# Generate: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
ConnectorStore__SecretsKey=
