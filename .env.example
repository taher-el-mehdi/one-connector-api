# Copy to .env. .env is not committed.
# Named instance example: DESKTOP-S4EOQ9N\BCDEMO
# LoginMode: Windows_Login (the Windows account running the process) or SQL_Server_Login.
# For SQL_Server_Login, set User and Password. For Windows_Login, leave both empty.
ConnectorStore__Server=
ConnectorStore__Database=
ConnectorStore__LoginMode=Windows_Login
ConnectorStore__User=
ConnectorStore__Password=
# Base64-encoded 32-byte key. Encrypts DocuWare and Sage passwords stored in SQL Server.
# Generate: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
ConnectorStore__SecretsKey=
