<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DocuWareSageConnector</RootNamespace>
    <AssemblyName>DocuWareSageConnector</AssemblyName>
    <UserSecretsId>docuware-sage-100-connector-8f3c2a1d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DocuWareSageConnector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocuWare.Platform.ServerClient" Version="16.11.1" />
    <PackageReference Include="DocuWare.Platform.ServerClient.Extensions" Version="14.11.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Polly" Version="8.6.4" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Database\Migrations\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
